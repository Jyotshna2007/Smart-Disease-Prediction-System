# Copy this file to .env and fill in the values.

# Optional: used by Gemini for reading PDF lab reports. Without it the built-in PDF text parser is used.
GEMINI_API_KEY="your-gemini-api-key"

# Secret used to sign login tokens. Use a long random string in production.
JWT_SECRET="change-me-to-a-long-random-string"

# Port the API listens on (the frontend dev server proxies /api to this port).
PORT=3000
