{
  "name": "smart-disease-prediction-backend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "API server: authentication, PDF extraction, ML prediction engine and report generation",
  "scripts": {
    "dev": "tsx watch --ignore data --ignore 'server/models/**' server.ts",
    "start": "tsx server.ts",
    "lint": "tsc --noEmit",
    "train": "python3 ../ml/train_models.py",
    "test:ml": "tsx ../ml/parity.test.ts && tsx ../ml/engine.scenarios.test.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "pdf-parse": "^2.4.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.14.0",
    "@types/pdf-parse": "^1.1.5",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
